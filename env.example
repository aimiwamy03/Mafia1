# Discord
DISCORD_TOKEN=your_discord_bot_token
DAY_CHANNEL_ID=123456789012345678
MAFIA_CHANNEL_ID=123456789012345678

# Lambda - Gemma on an on-demand GPU (SGLang OpenAI-compatible endpoint)
LAMBDA_BASE_URL=http://YOUR_LAMBDA_IP:30000/v1
LAMBDA_API_KEY=EMPTY
MODEL_A=google/gemma-2-9b-it
MODEL_B=google/gemma-2-9b-it

# Respan - add later so the dashboard shows every call
USE_RESPAN=false
RESPAN_API_KEY=your_respan_api_key
RESPAN_BASE_URL=https://api.respan.ai/api

# Nango — Post Office (Slack) + Photography (OpenAI images) + optional Bank proxy
NANGO_SECRET_KEY=your_nango_secret_key
NANGO_CONNECTION_ID=your_nango_connection_id
NANGO_PROVIDER_CONFIG_KEY=slack
SLACK_CHANNEL=#werewolf-recaps
NANGO_IMAGE_PROVIDER_CONFIG_KEY=openai
NANGO_IMAGE_CONNECTION_ID=
NANGO_IMAGE_MODEL=dall-e-3
NANGO_CRYPTO_PROVIDER_CONFIG_KEY=coingecko
NANGO_CRYPTO_CONNECTION_ID=
NANGO_CRYPTO_PATH=simple/price?ids=bitcoin,ethereum&vs_currencies=usd&include_24hr_change=true
